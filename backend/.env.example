# Server
ENV=development
PORT=8100
LOG_LEVEL=INFO

# Gemini (free tier via https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.6-flash
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_MAX_RETRIES=3

# Auth -- blank disables the X-API-Key requirement (local/dev default).
# Set this to any secret string to require it on every /prq/* route except
# /prq/health and /prq/health/ready.
BACKEND_API_KEY=

# CORS -- comma-separated list of allowed origins for a browser frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limits (per client IP). The LLM-backed endpoints get the tighter one.
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LLM=20/minute

# Data source -- "csv" (default) reads the local datasets; "supabase" fetches
# the same tables from a Supabase project instead (see supabase_schema.sql
# and migrate_to_supabase.py). SUPABASE_KEY should be the service_role key
# (Project Settings -> API), not the anon key -- this is a server-side-only
# credential, never exposed to a browser.
DATA_SOURCE=csv
SUPABASE_URL=
SUPABASE_KEY=
